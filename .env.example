# Offline demo needs none of these. Copy to .env for Docker Compose only.
# CLI reads exported environment variables; it does not automatically load .env.
MTR_API_KEY=
# Compose optional Redis profile: redis://redis:6379/0
REDIS_URL=
# Explicit opt-in; requires .[models], model download and appropriate hardware.
MTR_DENSE_MODEL=
MTR_RERANK_MODEL=
MTR_MODEL_DEVICE=cpu
# Configure BOTH fields to enable FAQ answer synthesis; never commit real keys.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
